# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.log

# ── ML artefacts ──────────────────────────────────────────────────────────────
# Trained models and scalers (regenerated by ml/train.py — keep metadata only)
ml/models/model.pkl
ml/models/scaler.pkl

# Evaluation outputs (regenerated by ml/evaluate.py)
ml/outputs/confusion_matrix.png
ml/outputs/feature_importance.png
ml/outputs/classification_report.txt
ml/outputs/summary.json
ml/outputs/evaluation_report.json
ml/outputs/vibration_score_analysis.json
ml/outputs/train.log

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
.kiro/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Arduino / PlatformIO ──────────────────────────────────────────────────────
.pio/
.pioenvs/
.piolibdeps/
firmware/*.hex
firmware/*.elf
firmware/*.bin

# ── Secrets / environment ─────────────────────────────────────────────────────
# NOTE: WIFI_SSID / WIFI_PASSWORD / ML_SERVER_IP are hardcoded in
#       firmware/gvms_final.ino — do not commit that file with real credentials.
.env
.env.*
secrets.json
credentials.json

# ── SD card data dumps (large binary/CSV exports from the device) ─────────────
firmware/data/
*.sdlog

# ── LaTeX build artifacts ─────────────────────────────────────────────────────
report/*.aux
report/*.log
report/*.lof
report/*.lot
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
report/*.bbl
report/*.blg


.tex